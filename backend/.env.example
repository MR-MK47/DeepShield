# DeepShield backend environment. Copy to .env and fill in real values.
# Do not commit .env or share provider keys.

# Resend: leave unset until real notice delivery is configured and tested.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DeepShield Legal <onboarding@resend.dev>

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local SQLite account/session metadata path (no images or embeddings).
AUTH_DB_PATH=./deepshield_auth.db

# Optional contact overrides; verify recipients before sending any real notice.
META_GRIEVANCE_EMAIL=fbgoindia@support.facebook.com
GOOGLE_ABUSE_EMAIL=abuse@google.com
X_ABUSE_EMAIL=abuse@x.com
TIKTOK_LEGAL_EMAIL=legal@tiktok.com

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
LOG_LEVEL=INFO
