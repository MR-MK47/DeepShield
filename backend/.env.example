# DeepShield backend environment. Copy to .env and fill in real values.
# Do not commit .env or share provider keys.

# Leave blank until real email delivery is configured and tested.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DeepShield Legal <onboarding@resend.dev>

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave blank to use the default database path inside backend/.
AUTH_DB_PATH=

# Populate only after independently verifying each destination address.
META_GRIEVANCE_EMAIL=
GOOGLE_ABUSE_EMAIL=
X_ABUSE_EMAIL=
TIKTOK_LEGAL_EMAIL=

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
LOG_LEVEL=INFO

# Optional: set to 1 for offline-safe pHash-only mode.
# DEEPSHIELD_DISABLE_FACE_MODEL=1
