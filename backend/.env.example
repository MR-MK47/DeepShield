# DeepShield backend environment. Copy to .env and fill in values as needed.
# Do not commit .env or share provider keys.

# auto sends through Resend when RESEND_API_KEY is configured; without a key,
# it falls back to local no-send mode. Set mock to force no-send testing or resend
# to require live delivery and fail clearly when credentials are missing.
NOTICE_EMAIL_MODE=auto
RESEND_API_KEY=
RESEND_FROM_EMAIL=DeepShield Legal <onboarding@resend.dev>

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave blank to use the default local database path inside backend/.
AUTH_DB_PATH=

# Contact email suggestions are searched on each matched website's public pages.
# Review the source page and edit/verify the recipient in the UI before sending.
# RESEND_FROM_EMAIL must use a sender/domain verified in your Resend account for
# external delivery; the onboarding@resend.dev address is for Resend testing.

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
LOG_LEVEL=INFO

# Optional: set to 1 to use pHash fallback without attempting to load ArcFace.
# DEEPSHIELD_DISABLE_FACE_MODEL=1
